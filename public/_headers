# Allow Firebase Auth popups — without this Cloudflare's default COOP header
# blocks Firebase from detecting popup closure, causing auth/modal glitches.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# HTML — always revalidate so updated app files are picked up immediately
/*.html
  Cache-Control: no-cache, must-revalidate

# App scripts and styles — revalidate on every request
/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

# Question bank JSON — revalidate (content changes when banks are updated)
/questions/*.json
  Cache-Control: no-cache, must-revalidate

# Static assets (icons, manifest, images) — cache for 7 days
/*.png
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=86400
