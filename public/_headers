# Allow Firebase Auth popups — without this Cloudflare's default COOP header
# blocks Firebase from detecting popup closure, causing auth/modal glitches.
/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://www.gstatic.com https://rise-511c6.firebaseapp.com https://mygr10-family.ravi-boorla.workers.dev https://static.cloudflareinsights.com https://accounts.google.com wss://*.firebaseio.com; img-src 'self' data: https:; frame-src https://rise-511c6.firebaseapp.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# HTML — always revalidate so updated app files are picked up immediately
/*.html
  Cache-Control: no-cache, must-revalidate

# App scripts and styles — versioned via query string so safe to cache 1 day
/*.js
  Cache-Control: public, max-age=86400

/*.css
  Cache-Control: public, max-age=86400

# Question bank JSON — revalidate (content changes when banks are updated)
/questions/*.json
  Cache-Control: no-cache, must-revalidate

# Static assets (icons, manifest, images) — cache for 7 days
/*.png
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400
