{
  "name": "cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency Cloudflare Workers template with router, middleware, and structured logging.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  },
  "engines": {
    "node": ">=18"
  },
  "cloudflare": {
    "kv_namespaces": [
      {
        "binding": "RATE_LIMIT_KV",
        "id": "REPLACE_WITH_KV_NAMESPACE_ID"
      }
    ]
  }
}