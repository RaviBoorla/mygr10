{
  "name": "mygr10",
  "version": "1.0.0",
  "private": true,
  "description": "Practice and self-assessment app for Indian Grade 10 board exam students (CBSE / ICSE / IB).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "echo 'Static site — no build step required'",
    "dev": "npx serve public",
    "deploy": "wrangler pages deploy public",
    "stamp": "node scripts/stamp-versions.mjs",
    "check": "node scripts/check-banks.mjs && node scripts/stamp-versions.mjs --check",
    "test:smoke": "node tests/smoke.test.mjs",
    "test:rules": "tests/node_modules/.bin/firebase emulators:exec --only firestore --project demo-rise \"node tests/firestore-rules.test.mjs\""
  },
  "engines": {
    "node": ">=18"
  }
}
